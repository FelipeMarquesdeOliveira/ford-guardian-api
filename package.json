{
  "name": "ford-guardian-api",
  "version": "3.0.0",
  "description": "Ford Guardian API - Sprint 3 Cybersecurity (DevSecOps)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "iot:simular": "node iot/simulador-dispositivo.js",
    "trafego:demo": "node scripts/gerar-trafego.js"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Felipe Marques de Oliveira, Gabriel Barros Cisoto",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup-env.js"],
    "coverageReporters": ["text-summary", "lcov"],
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
