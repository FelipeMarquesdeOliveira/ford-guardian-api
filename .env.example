# Copie para .env e preencha. Nunca versione o .env (ver .gitignore).
PORT=3000
NODE_ENV=development

# JWT: gere com `openssl rand -base64 48` (mínimo 32 bytes)
JWT_SECRET=
JWT_EXPIRES_IN=15m

# AES-256-GCM: 32 bytes em base64 -> `openssl rand -base64 32`
ENCRYPTION_KEY=

# HMAC da telemetria IoT (dispositivo -> API): `openssl rand -hex 32`
IOT_HMAC_SECRET=

# Token de leitura do endpoint /metrics (Prometheus): `openssl rand -hex 24`
METRICS_TOKEN=

ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# HTTPS opcional (TLS 1.2+): caminhos do certificado e da chave
TLS_CERT_PATH=
TLS_KEY_PATH=
